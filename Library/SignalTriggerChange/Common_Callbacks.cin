//! ========== CYCLE DETECTION CALLBACKS ==========

/// <CycleDetection_Variable>
/**
* Callback for cycle detection - tracks complete violation→recovery cycles for system variables
*
* @param[out] check - Check ID for background TASK
*
* @details Detects state transitions (NORMAL ↔ VIOLATED) and counts complete cycles.
*          A complete cycle = violation occurs → signal returns to normal range.
*          Optionally validates cycle intervals and stops CANoe when threshold is reached.
*
*///***************************************************************************** 
void SVC_CAPL_Callback_Sys_Value_Range_CycleDetection(dword check)
{
  double result;
  int64 measureValue;
  long timeStemp;
  dword currentTime;
  dword isValueInViolation;
  dword cycleInterval;
  
  timeStemp = ChkQuery_EventTimeStamp(check); 
  result = ChkQuery_EventSignalValue(check, measureValue);
  currentTime = timeNowInt64() / 100000; // Convert to milliseconds
  
  if (result < 0 || timeStemp < 0)
  {
    testStepFail("", "SVC_CAPL_Callback_Sys_Value_Range_CycleDetection!, Error occurred. ErrorCode : %d (SystemVariableValue: %d, timeStemp: %d)", result, measureValue, timeStemp);
    return;
  }
  
  // Determine if current value is in violation
  isValueInViolation = 0;
  if (gExpectedMinValue <= measureValue && gExpectedMaxValue >= measureValue)
  {
    // Value is inside range
    if (gIsValueInsideRangeExpected == NO)
      isValueInViolation = 1; // We're looking for values OUTSIDE range, so this is NOT a violation
    else
      isValueInViolation = 0; // We're looking for values INSIDE range, so this IS what we want (not violation)
  }
  else
  {
    // Value is outside range
    if (gIsValueInsideRangeExpected == YES)
      isValueInViolation = 1; // We're looking for values INSIDE range, so this IS a violation
    else
      isValueInViolation = 0; // We're looking for values OUTSIDE range, so this is what we want (not violation)
  }
  
  // State machine for cycle detection
  if (isValueInViolation)
  {
    // Currently in VIOLATION state
    if (gCurrentState == STATE_NORMAL)
    {
      // Transition: NORMAL VIOLATED
      gCurrentState = STATE_VIOLATED;
      gViolationStartTime = currentTime;
      
      testStepWarning("", "SVC_CAPL_Callback_Sys_CycleDetection, VIOLATION STARTED at %d ms, value: %d (Range: %d...%d)", 
                      currentTime, measureValue, gExpectedMinValue, gExpectedMaxValue);
    }
    // else: already in violation, continue
  }
  else
  {
    // Currently in NORMAL range
    if (gCurrentState == STATE_VIOLATED)
    {
      // Transition: VIOLATED NORMAL (COMPLETE CYCLE!)
      gCurrentState = STATE_NORMAL;
      gRecoveryStartTime = currentTime;
      
      // Increment cycle count
      gCompleteCycleCount++;
      
      // Calculate cycle interval (if this isn't the first cycle)
      if (gCompleteCycleCount > 1 && gLastViolationEndTime > 0)
      {
        cycleInterval = gViolationStartTime - gLastViolationEndTime;
        
        testStepWarning("", "SVC_CAPL_Callback_Sys_CycleDetection, CYCLE #%d COMPLETED at %d ms, value: %d, Cycle interval: %d ms", 
                        gCompleteCycleCount, currentTime, measureValue, cycleInterval);
        
        // Validate cycle interval if specified
        if (gExpectedCycleIntervalMs > 0)
        {
          dword intervalDiff;
          if (cycleInterval > gExpectedCycleIntervalMs)
            intervalDiff = cycleInterval - gExpectedCycleIntervalMs;
          else
            intervalDiff = gExpectedCycleIntervalMs - cycleInterval;
          
          if (intervalDiff > gCycleIntervalToleranceMs)
          {
            testStepWarning("", "WARNING: Cycle interval %d ms is outside tolerance! Expected: %d ms ± %d ms", 
                            cycleInterval, gExpectedCycleIntervalMs, gCycleIntervalToleranceMs);
          }
        }
      }
      else
      {
        testStepWarning("", "SVC_CAPL_Callback_Sys_CycleDetection, CYCLE #%d COMPLETED (FIRST) at %d ms, value: %d", 
                        gCompleteCycleCount, currentTime, measureValue);
      }
      
      gLastViolationEndTime = currentTime;
      
      // Check if we've reached expected cycle count
      if (gExpectedCycles > 0 && gCompleteCycleCount >= gExpectedCycles)
      {
        if (gUserExpectation == YES)
        {
          gChangeResult = 1; // User expected cycles to occur - PASS
          testStepWarning("", "PASSED - Expected cycle count (%d) reached! User expectation: MET (PASS)", gExpectedCycles);
        }
        else
        {
          gChangeResult = 0; // User did NOT expect cycles to occur - FAIL
          testStepWarning("", "FAILED - Expected cycle count (%d) reached! User expectation: NOT MET (FAIL)", gExpectedCycles);
        }
        
        // Stop CANoe if configured
        if (gStopCanoeOnCycleReached == YES)
        {
          testStepFail("Error", "Forcefully stopping CANoe - Cycle count threshold reached (%d cycles detected)", gCompleteCycleCount);
          stop();
        }
      }
    }
    // else: already in normal, continue
  }
}

/// <CycleDetection_Signal>
/**
* Callback for cycle detection - tracks complete violation→recovery cycles for signals
*
* @param[out] check - Check ID for background TASK
*
* @details Detects state transitions (NORMAL ↔ VIOLATED) and counts complete cycles.
*          A complete cycle = violation occurs → signal returns to normal range.
*          Optionally validates cycle intervals and stops CANoe when threshold is reached.
*
*///***************************************************************************** 
void SVC_CAPL_Callback_Signal_Value_Range_CycleDetection(dword check)
{
  double result;
  int64 measureValue;
  long timeStemp;
  dword currentTime;
  dword isValueInViolation;
  dword cycleInterval;
  
  timeStemp = ChkQuery_EventTimeStamp(check); 
  result = ChkQuery_EventSignalValue(check, measureValue);
  currentTime = timeNowInt64() / 100000; // Convert to milliseconds
  
  if (result < 0 || timeStemp < 0)
  {
    testStepFail("", "SVC_CAPL_Callback_Signal_Value_Range_CycleDetection!, Error occurred. ErrorCode : %d (SignalValue: %d, timeStemp: %d)", result, measureValue, timeStemp);
    return;
  }
  
  // Determine if current value is in violation
  isValueInViolation = 0;
  if (gExpectedMinValue <= measureValue && gExpectedMaxValue >= measureValue)
  {
    // Value is inside range
    if (gIsValueInsideRangeExpected == NO)
      isValueInViolation = 1; // We're looking for values OUTSIDE range, so this is NOT a violation
    else
      isValueInViolation = 0; // We're looking for values INSIDE range, so this IS what we want (not violation)
  }
  else
  {
    // Value is outside range
    if (gIsValueInsideRangeExpected == YES)
      isValueInViolation = 1; // We're looking for values INSIDE range, so this IS a violation
    else
      isValueInViolation = 0; // We're looking for values OUTSIDE range, so this is what we want (not violation)
  }
  
  // State machine for cycle detection
  if (isValueInViolation)
  {
    // Currently in VIOLATION state
    if (gCurrentState == STATE_NORMAL)
    {
      // Transition: NORMAL VIOLATED
      gCurrentState = STATE_VIOLATED;
      gViolationStartTime = currentTime;
      
      testStepWarning("", "SVC_CAPL_Callback_Signal_CycleDetection, VIOLATION STARTED at %d ms, value: %d (Range: %d...%d)", 
                      currentTime, measureValue, gExpectedMinValue, gExpectedMaxValue);
    }
    // else: already in violation, continue
  }
  else
  {
    // Currently in NORMAL range
    if (gCurrentState == STATE_VIOLATED)
    {
      // Transition: VIOLATED NORMAL (COMPLETE CYCLE!)
      gCurrentState = STATE_NORMAL;
      gRecoveryStartTime = currentTime;
      
      // Increment cycle count
      gCompleteCycleCount++;
      
      // Calculate cycle interval (if this isn't the first cycle)
      if (gCompleteCycleCount > 1 && gLastViolationEndTime > 0)
      {
        cycleInterval = gViolationStartTime - gLastViolationEndTime;
        
        testStepWarning("", "SVC_CAPL_Callback_Signal_CycleDetection, CYCLE #%d COMPLETED at %d ms, value: %d, Cycle interval: %d ms", 
                        gCompleteCycleCount, currentTime, measureValue, cycleInterval);
        
        // Validate cycle interval if specified
        if (gExpectedCycleIntervalMs > 0)
        {
          dword intervalDiff;
          if (cycleInterval > gExpectedCycleIntervalMs)
            intervalDiff = cycleInterval - gExpectedCycleIntervalMs;
          else
            intervalDiff = gExpectedCycleIntervalMs - cycleInterval;
          
          if (intervalDiff > gCycleIntervalToleranceMs)
          {
            testStepWarning("", "WARNING: Cycle interval %d ms is outside tolerance! Expected: %d ms ± %d ms", 
                            cycleInterval, gExpectedCycleIntervalMs, gCycleIntervalToleranceMs);
          }
        }
      }
      else
      {
        testStepWarning("", "SVC_CAPL_Callback_Signal_CycleDetection, CYCLE #%d COMPLETED (FIRST) at %d ms, value: %d", 
                        gCompleteCycleCount, currentTime, measureValue);
      }
      
      gLastViolationEndTime = currentTime;
      
      // Check if we've reached expected cycle count
      if (gExpectedCycles > 0 && gCompleteCycleCount >= gExpectedCycles)
      {
        if (gUserExpectation == YES)
        {
          gChangeResult = 1; // User expected cycles to occur - PASS
          testStepWarning("", "PASSED - Expected cycle count (%d) reached! User expectation: MET (PASS)", gExpectedCycles);
        }
        else
        {
          gChangeResult = 0; // User did NOT expect cycles to occur - FAIL
          testStepWarning("", "FAILED - Expected cycle count (%d) reached! User expectation: NOT MET (FAIL)", gExpectedCycles);
        }
        
        // Stop CANoe if configured
        if (gStopCanoeOnCycleReached == YES)
        {
          testStepFail("Error", "Forcefully stopping CANoe - Cycle count threshold reached (%d cycles detected)", gCompleteCycleCount);
          stop();
        }
      }
    }
    // else: already in normal, continue
  }
}

//! ========== PARALLEL OBSERVATION CALLBACKS ==========

/// <ParallelObservation_Variable>
/**
* Callback for parallel observation - chkStart_SignalValueChange
*
* @param[out] check - Check ID for background TASK
*
*///***************************************************************************** 
void SVC_CAPL_Callback_Sys_Parallel(dword check)
{
  long timeStemp;
  dword i;
  
  // Find the observation context for this check ID
  for (i = 0; i < kMaxParallelObservations; i++)
  {
    if (gObservations[i].isActive && gObservations[i].checkID == check)
    {
      timeStemp = ChkQuery_EventTimeStamp(check); 
      testStepWarning("", "SVC_CAPL_Callback_Sys_Parallel [%s], Signal/variable value change occurred at time : %d", gObservations[i].observedName, timeStemp);
      
      gObservations[i].changeResult = 1;
      break;
    }
  }
}

/// <ParallelObservation_Variable>
/**
* Callback for parallel observation - chkStart_SignalValueChange with specific value
*
* @param[out] check - Check ID for background TASK
*
*///***************************************************************************** 
void SVC_CAPL_Callback_Sys_Value_Parallel(dword check)
{
  double result;
  int64 measureValue;
  long timeStemp;
  dword i;
  
  // Find the observation context for this check ID
  for (i = 0; i < kMaxParallelObservations; i++)
  {
    if (gObservations[i].isActive && gObservations[i].checkID == check)
    {
      timeStemp = ChkQuery_EventTimeStamp(check); 
      result = ChkQuery_EventSignalValue(check, measureValue);
      
      if (result < 0 || timeStemp < 0)
        testStepFail("", "SVC_CAPL_Callback_Sys_Value_Parallel [%s]!, Error ocurred. ErrorCode : %d (SignalValue: %d, timeStemp: %d)", gObservations[i].observedName, result, measureValue, timeStemp);
      else
        testStepWarning("", "SVC_CAPL_Callback_Sys_Value_Parallel [%s], Signal/variable value change occurred at time : %d, value : %d", gObservations[i].observedName, timeStemp, measureValue);
      
      if (measureValue == gObservations[i].expectedValue)
      {
        gObservations[i].changeResult = 1;
      }
      break;
    }
  }
}

/// <ParallelObservation_Variable>
/**
* Callback for parallel observation - ChkStart_MsgSignalValueRangeViolation & ChkStart_MsgSignalValueInvalid
*
* @param[out] check - Check ID for background TASK
*
*///***************************************************************************** 
void SVC_CAPL_Callback_Sys_Value_Range_Parallel(dword check)
{
  double result;
  int64 measureValue;
  long timeStemp;
  dword i;
  
  // Find the observation context for this check ID
  for (i = 0; i < kMaxParallelObservations; i++)
  {
    if (gObservations[i].isActive && gObservations[i].checkID == check)
    {
      timeStemp = ChkQuery_EventTimeStamp(check); 
      result = ChkQuery_EventSignalValue(check, measureValue);
      
      if (result < 0 || timeStemp < 0)
        testStepFail("", "SVC_CAPL_Callback_Sys_Value_Range_Parallel [%s]!, Error ocurred. ErrorCode : %d (SystemVariableValue: %d, timeStemp: %d)", gObservations[i].observedName, result, measureValue, timeStemp);
      else
        testStepWarning("", "SVC_CAPL_Callback_Sys_Value_Range_Parallel [%s], Signal/variable value range violation occurred at time : %d, value : %d", gObservations[i].observedName, timeStemp, measureValue);
       
      if (gObservations[i].expectedMinValue <= measureValue && gObservations[i].expectedMaxValue >= measureValue)
      {
        if (gObservations[i].isValueInsideRangeExpected == 1)
          gObservations[i].changeResult = 0;
        else
          gObservations[i].changeResult = 1; 
      }
      else
      {
        if (gObservations[i].isValueInsideRangeExpected == 1)
          gObservations[i].changeResult = 1;
        else
          gObservations[i].changeResult = 0;
      }
      break;
    }
  }
}

