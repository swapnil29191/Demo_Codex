/// <StartObervation>
/**
* @brief Stops the background observation of signal or system variable value changes.
*
* @details Removes the test condition associated with the current observation and logs the stop event.
*
* @verdict Failed to stop to Observation \n
*          Passed Successfully stopped background observation
*///*****************************************************************************
export void Lib_SVC_StopObservation()
{
  long ret;
  ret = testRemoveCondition(gCheckID_VC);
  
  if (ret == 0)
    testStep("Observation", "Background check of Stopped.");
  else
    testStepFail("Observation", "Background check does not Stopped. Constraint could not be removed");
  
  // stop the check
  ChkControl_Stop(gCheckID_VC);

  // reset stored values of the check
  ChkControl_Destroy(gCheckID_VC);
}

/// <StartObervation>
/**
* @brief Validates whether a value change occurred during the observation period.
*
* @param[in] IsChangeExpected YES if a change was expected, NO otherwise.
*
* @details Checks if the observed value change matches the expectation and reports the result as a test step pass or fail. 
*
*///*****************************************************************************
export void Lib_SVC_ValidateResult(enum eChangeExpected IsChangeExpected)
{
  if (IsChangeExpected == 1)
  {
    if(gChangeResult)
      testStepPass("Validation", "Signal Or SysVaribale value has change as Expected");
    else
      testStepFail("Validation", "Signal Or SysVaribale value has NOT change as Expected"); 
  }
  else
  {
    if(gChangeResult == 0)
      testStepPass("Validation", "Signal Or SysVaribale value has NOT change as Expected");
    else
      testStepFail("Validation", "Signal Or SysVaribale value has change which is not Expected");
  }
}

/// <StratObservation_CountTime>
/**
* @brief Validates whether value changes occurred with expected count and within time window.
*
* @param[in] IsChangeExpected - YES if changes were expected, NO otherwise
* @param[in] minCount - Minimum expected count (use same as maxCount for exact count)
* @param[in] maxCount - Maximum expected count
*
* @details Validates that the number of changes falls within the expected range.
*          Reports detailed information about change count.
*
*///*****************************************************************************
export void Lib_SVC_ValidateResultWithCount(enum eChangeExpected IsChangeExpected, dword minCount, dword maxCount)
{
  dword currentTime;
  dword totalElapsedTime;
  
  currentTime = timeNowInt64() / 100000;
  totalElapsedTime = currentTime - gStartTimestamp;
  
  if (IsChangeExpected == 1)
  {
    if (gChangeCount >= minCount && gChangeCount <= maxCount)
    {
      testStepPass("Validation", "Change count (%d) is within expected range [%d, %d]. Total observation time: %d ms", 
                   gChangeCount, minCount, maxCount, totalElapsedTime);
    }
    else
    {
      testStepFail("Validation", "Change count (%d) is NOT within expected range [%d, %d]. Total observation time: %d ms", 
                   gChangeCount, minCount, maxCount, totalElapsedTime);
    }
  }
  else
  {
    if (gChangeCount < minCount || gChangeCount > maxCount)
    {
      testStepPass("Validation", "Change count (%d) is outside expected range [%d, %d] as expected. Total observation time: %d ms", 
                   gChangeCount, minCount, maxCount, totalElapsedTime);
    }
    else
    {
      testStepFail("Validation", "Change count (%d) is within range [%d, %d] but was not expected. Total observation time: %d ms", 
                   gChangeCount, minCount, maxCount, totalElapsedTime);
    }
  }
}

/// <StratObservation_CountTime>
/**
* @brief Validates value changes with both count and time window constraints.
*
* @param[in] IsChangeExpected - YES if changes meeting criteria were expected, NO otherwise
* @param[in] expectedCount - Expected number of changes
* @param[in] maxTimeWindowMs - Maximum time window in milliseconds (0 = no time constraint)
*
* @details Comprehensive validation checking:
*          1. Whether expected count was reached
*          2. Whether changes occurred within the time window
*          3. Time between first and last change
*          
*          This function should be called after Lib_SVC_StartObservation() with count/time parameters.
*
* @example
*          Lib_SVC_StartObservation(@sysvar::MyVar, 10, 50, NO, 3, 5000);
*          testWaitForTimeout(6000);  // Wait for potential changes
*          Lib_SVC_ValidateResultWithCountAndTime(YES, 3, 5000);  // Validate 3 changes within 5000ms
*
*///*****************************************************************************
export void Lib_SVC_ValidateResultWithCountAndTime(enum eChangeExpected IsChangeExpected, dword expectedCount, dword maxTimeWindowMs)
{
  dword currentTime;
  dword totalElapsedTime;
  dword changeDuration;
  
  currentTime = timeNowInt64() / 100000;
  totalElapsedTime = currentTime - gStartTimestamp;
  
  // Calculate time between FIRST and LAST change (key requirement)
  if (gChangeCount >= 2 && gFirstChangeTimestamp > 0 && gLastChangeTimestamp > 0)
  {
    changeDuration = gLastChangeTimestamp - gFirstChangeTimestamp;
  }
  else if (gChangeCount == 1)
  {
    changeDuration = 0; // Only one change, no duration
  }
  else
  {
    changeDuration = 0; // No changes yet
  }
  
  if (IsChangeExpected == 1)
  {
    // Expected changes to occur
    if (gChangeCount >= expectedCount)
    {
      // Check time window constraint between FIRST and LAST change
      if (maxTimeWindowMs == 0 || changeDuration <= maxTimeWindowMs)
      {
        testStepPass("Validation", "SUCCESS: %d changes occurred (expected: %d). Duration from FIRST to LAST change: %d ms (limit: %d ms) - WITHIN TIME WINDOW", 
                     gChangeCount, expectedCount, changeDuration, maxTimeWindowMs);
      }
      else
      {
        testStepFail("Validation", "FAIL: %d changes occurred (expected: %d) but duration EXCEEDED. Duration: %d ms (limit: %d ms)", 
                     gChangeCount, expectedCount, changeDuration, maxTimeWindowMs);
      }
    }
    else
    {
      testStepFail("Validation", "FAIL: Only %d changes occurred (expected: %d). Duration from first to last: %d ms, Total observation time: %d ms", 
                   gChangeCount, expectedCount, changeDuration, totalElapsedTime);
    }
  }
  else
  {
    // Expected NO changes or changes outside criteria
    if (gChangeCount < expectedCount)
    {
      testStepPass("Validation", "SUCCESS: Only %d changes occurred (less than: %d) as expected. Total observation time: %d ms", 
                   gChangeCount, expectedCount, totalElapsedTime);
    }
    else if (maxTimeWindowMs > 0 && changeDuration > maxTimeWindowMs)
    {
      testStepPass("Validation", "SUCCESS: %d changes occurred but duration exceeded (%d ms > %d ms) as expected", 
                   gChangeCount, changeDuration, maxTimeWindowMs);
    }
    else
    {
      testStepFail("Validation", "FAIL: %d changes occurred with duration %d ms (expected: NOT to meet criteria). Total time: %d ms", 
                   gChangeCount, changeDuration, totalElapsedTime);
    }
  }
}

/// <StratObservation_CountTime>
/**
* @brief Gets the current change count during observation.
*
* @return dword - Current number of changes detected
*
* @details Allows checking the change count without stopping or validating the observation.
*          Useful for conditional test logic based on change count.
*
*///*****************************************************************************
export dword Lib_SVC_GetChangeCount()
{
  return gChangeCount;
}

/// <StratObservation_CountTime>
/**
* @brief Gets the elapsed time since observation started.
*
* @return dword - Elapsed time in milliseconds
*
* @details Returns the time elapsed since Lib_SVC_StartObservation() was called.
*
*///*****************************************************************************
export dword Lib_SVC_GetElapsedTime()
{
  dword currentTime;
  currentTime = timeNowInt64() / 100000;
  return (currentTime - gStartTimestamp);
}

/// <StratObservation_CountTime>
/**
* @brief Gets the time duration between first and last change.
*
* @return dword - Duration in milliseconds (0 if no changes occurred)
*
* @details Returns the time span from the first detected change to the last detected change.
*          Returns 0 if less than 2 changes have occurred.
*
*///*****************************************************************************
export dword Lib_SVC_GetChangeDuration()
{
  if (gChangeCount >= 2 && gFirstChangeTimestamp > 0 && gLastChangeTimestamp > 0)
  {
    return (gLastChangeTimestamp - gFirstChangeTimestamp);
  }
  return 0;
}

/// <StartObservation_CycleDetection>
//! ==================== CYCLE DETECTION VALIDATION AND HELPERS ====================

/**
* @brief Validates whether complete cycles occurred as expected.
*
* @param[in] IsChangeExpected - YES if cycles were expected, NO otherwise
* @param[in] expectedCycles - Expected number of complete cycles
*
* @details Checks if the observed complete cycle count matches the expectation.
*          A complete cycle = violation occurs → signal returns to normal.
*          Reports detailed test results including cycle count and timing information.
*
* @example
*          Lib_SVC_StartObservation_CycleDetection(@sysvar::Voltage, 5, 100, YES, 3, NO);
*          testWaitForTimeout(60000);  // Wait for cycles to occur
*          Lib_SVC_ValidateResultWithCycles(YES, 3);  // Validate 3 cycles occurred
*
*///*****************************************************************************
export void Lib_SVC_ValidateResultWithCycles(enum eChangeExpected IsChangeExpected, dword expectedCycles)
{
  dword currentTime;
  dword totalElapsedTime;
  
  currentTime = timeNowInt64() / 100000;
  totalElapsedTime = currentTime - gStartTimestamp;
  
  if (IsChangeExpected == YES)
  {
    if (gCompleteCycleCount >= expectedCycles)
    {
      testStepPass("Validation", "Expected cycle count REACHED: %d complete cycles detected (expected: %d). Total observation time: %d ms", 
                   gCompleteCycleCount, expectedCycles, totalElapsedTime);
    }
    else
    {
      testStepFail("Validation", "Expected cycle count NOT reached: only %d complete cycles detected (expected: %d). Total observation time: %d ms", 
                   gCompleteCycleCount, expectedCycles, totalElapsedTime);
    }
  }
  else
  {
    if (gCompleteCycleCount < expectedCycles)
    {
      testStepPass("Validation", "Cycles did NOT reach threshold as expected: %d complete cycles detected (threshold: %d). Total observation time: %d ms", 
                   gCompleteCycleCount, expectedCycles, totalElapsedTime);
    }
    else
    {
      testStepFail("Validation", "Cycles REACHED threshold unexpectedly: %d complete cycles detected (threshold: %d). Total observation time: %d ms", 
                   gCompleteCycleCount, expectedCycles, totalElapsedTime);
    }
  }
}

/// <StartObservation_CycleDetection>
/**
* @brief Validates cycles with interval checking.
*
* @param[in] IsChangeExpected - YES if cycles were expected, NO otherwise
* @param[in] expectedCycles - Expected number of complete cycles
* @param[in] expectedIntervalMs - Expected interval between cycles in milliseconds
* @param[in] toleranceMs - Tolerance for interval validation in milliseconds
*
* @details Enhanced validation that checks both cycle count and timing intervals.
*          Useful for detecting periodic patterns (e.g., signal drops every 10 seconds).
*
*///*****************************************************************************
export void Lib_SVC_ValidateResultWithCyclesAndInterval(enum eChangeExpected IsChangeExpected, 
                                                        dword expectedCycles, 
                                                        dword expectedIntervalMs, 
                                                        dword toleranceMs)
{
  dword currentTime;
  dword totalElapsedTime;
  dword averageInterval;
  
  currentTime = timeNowInt64() / 100000;
  totalElapsedTime = currentTime - gStartTimestamp;
  
  // Calculate average interval if we have multiple cycles
  if (gCompleteCycleCount > 1 && gFirstChangeTimestamp > 0 && gLastViolationEndTime > 0)
  {
    averageInterval = (gLastViolationEndTime - gFirstChangeTimestamp) / (gCompleteCycleCount - 1);
  }
  else
  {
    averageInterval = 0;
  }
  
  if (IsChangeExpected == YES)
  {
    if (gCompleteCycleCount >= expectedCycles)
    {
      // Check interval if we have enough cycles
      if (gCompleteCycleCount > 1)
      {
        dword intervalDiff;
        if (averageInterval > expectedIntervalMs)
          intervalDiff = averageInterval - expectedIntervalMs;
        else
          intervalDiff = expectedIntervalMs - averageInterval;
        
        if (intervalDiff <= toleranceMs)
        {
          testStepPass("Validation", "Cycles detected with correct interval: %d cycles, avg interval: %d ms (expected: %d ms ± %d ms). Observation time: %d ms", 
                       gCompleteCycleCount, averageInterval, expectedIntervalMs, toleranceMs, totalElapsedTime);
        }
        else
        {
          testStepFail("Validation", "Cycles detected but interval OUT OF TOLERANCE: %d cycles, avg interval: %d ms (expected: %d ms ± %d ms). Observation time: %d ms", 
                       gCompleteCycleCount, averageInterval, expectedIntervalMs, toleranceMs, totalElapsedTime);
        }
      }
      else
      {
        testStepPass("Validation", "Expected cycle count reached: %d complete cycles (expected: %d). Observation time: %d ms", 
                     gCompleteCycleCount, expectedCycles, totalElapsedTime);
      }
    }
    else
    {
      testStepFail("Validation", "Expected cycle count NOT reached: only %d complete cycles (expected: %d). Observation time: %d ms", 
                   gCompleteCycleCount, expectedCycles, totalElapsedTime);
    }
  }
  else
  {
    if (gCompleteCycleCount < expectedCycles)
    {
      testStepPass("Validation", "Cycles did NOT reach threshold as expected: %d complete cycles (threshold: %d). Observation time: %d ms", 
                   gCompleteCycleCount, expectedCycles, totalElapsedTime);
    }
    else
    {
      testStepFail("Validation", "Cycles REACHED threshold unexpectedly: %d complete cycles (threshold: %d). Observation time: %d ms", 
                   gCompleteCycleCount, expectedCycles, totalElapsedTime);
    }
  }
}

/// <StartObservation_CycleDetection>
/**
* @brief Gets the current complete cycle count.
*
* @return dword - Current number of complete cycles detected
*
* @details Returns the count of complete violation→recovery cycles.
*          Useful for checking progress without stopping observation.
*
*///*****************************************************************************
export dword Lib_SVC_GetCompleteCycleCount()
{
  return gCompleteCycleCount;
}

/// <StartObservation_CycleDetection>
/**
* @brief Gets the current observation state.
*
* @return dword - Current state (0=NORMAL, 1=VIOLATED)
*
* @details Returns whether the signal/variable is currently in normal range or violation.
*          0 = STATE_NORMAL (within expected range)
*          1 = STATE_VIOLATED (outside expected range)
*
*///*****************************************************************************
export dword Lib_SVC_GetCurrentState()
{
  return gCurrentState;
}

/// <StartObservation_CycleDetection>
/**
* @brief Gets the time of the last completed cycle (when signal returned to normal).
*
* @return dword - Timestamp in milliseconds (0 if no cycles completed)
*
* @details Returns the timestamp when the last cycle was completed (recovery occurred).
*
*///*****************************************************************************
export dword Lib_SVC_GetLastCycleCompletionTime()
{
  return gLastViolationEndTime;
}

/// <StartObservation_CycleDetection>
/**
* @brief Gets the timestamp when the current/last violation started.
*
* @return dword - Timestamp in milliseconds (0 if no violation occurred)
*
*///*****************************************************************************
export dword Lib_SVC_GetViolationStartTime()
{
  return gViolationStartTime;
}

/// <StartObservation_CycleDetection>
/**
* @brief Resets cycle detection counters and state.
*
* @details Useful for restarting cycle detection without stopping/restarting observation.
*          Resets: cycle count, state, timestamps.
*          Note: Does NOT stop the background observation.
*
*///*****************************************************************************
export void Lib_SVC_ResetCycleDetection()
{
  gCompleteCycleCount = 0;
  gCurrentState = STATE_NORMAL;
  gViolationStartTime = 0;
  gRecoveryStartTime = 0;
  gLastViolationEndTime = 0;
  gChangeResult = 0;
  gStartTimestamp = timeNowInt64() / 100000;
  
  testStep("Reset", "Cycle detection counters and state have been reset");
}

/// <StartParallelObservation>
//! ==================== PARALLEL OBSERVATION SUPPORT ====================

//! Helper function to find an available observation slot
dword FindAvailableObservationSlot()
{
  dword i;
  for (i = 0; i < kMaxParallelObservations; i++)
  {
    if (!gObservations[i].isActive)
    {
      return i;
    }
  }
  return kMaxParallelObservations; // No slot available
}

/// <StartParallelObservation>
//! Helper function to store observation name
void StoreObservationName(dword slotIndex, char observedName[])
{
  long i;
  long len;
  len = strlen(observedName);
  if (len > 255) len = 255;
  
  for (i = 0; i < len; i++)
  {
    gObservations[slotIndex].observedName[i] = observedName[i];
  }
  gObservations[slotIndex].observedName[len] = 0; // Null terminator
}

/// <StartParallelObservation/SysInt>
/**
 * @brief Starts parallel background observation for value changes of an integer system variable.
*
* @param[in] sysVarName - Int dataType System Variable Name
*
 * @return dword - Observation handle (slot index) for stopping or validating later
 * @details Initiates monitoring for any value change of the specified integer system variable in parallel mode.
 *          Returns a handle that can be used to stop or validate this specific observation.
 *
* @verdict Failed to start background observation \n
*          Passed Successfully started background observation
*///***************************************************************************** 
export dword Lib_SVC_StartParallelObservation(sysvarInt* sysVarName)
{
  dword slotIndex;
  dword checkID;
  
  #pragma warning(disable: 2038)
  
  slotIndex = FindAvailableObservationSlot();
  
  if (slotIndex >= kMaxParallelObservations)
  {
    testStepFail("", "No available observation slots. Maximum %d parallel observations supported.", kMaxParallelObservations);
    return kMaxParallelObservations;
  }
  
  // Initialize observation context
  gObservations[slotIndex].changeResult = 0;
  gObservations[slotIndex].isActive = 1;
  StoreObservationName(slotIndex, sysVarName.name);
  
  // Start the check
  checkID = chkStart_SignalValueChange(sysVarName, "SVC_CAPL_Callback_Sys_Parallel");
  
  if (!checkID)
  {
    gObservations[slotIndex].isActive = 0;
    testStepFail("", "System Variable Value change could not start, System Variable not available OR CAPL callback does not exist");
    return kMaxParallelObservations;
  }
  
  gObservations[slotIndex].checkID = checkID;
  testAddCondition(checkID, VerdictNotExpected); 
  testStep("Observation", "Parallel background check [Handle: %d] of System variable : \"%s\" started", slotIndex, sysVarName.name);
  
  return slotIndex;
}

/// <StartParallelObservation/SysInt>
/**
 * @brief Starts parallel background observation for a specific value change of an integer system variable.
*
* @param[in] sysVarName - Int dataType System Variable Name
* @param[in] variableValue - Expected variable value change
*
 * @return dword - Observation handle (slot index) for stopping or validating later
 *
 * @details Initiates monitoring for a specific value change of the given integer system variable in parallel mode.
 *
* @verdict Failed to start background observation \n
*          Passed Successfully started background observation
*///***************************************************************************** 
export dword Lib_SVC_StartParallelObservation(sysvarInt* sysVarName, long variableValue)
{
  dword slotIndex;
  dword checkID;
  
  #pragma warning(disable: 2038)
  
  slotIndex = FindAvailableObservationSlot();
  
  if (slotIndex >= kMaxParallelObservations)
  {
    testStepFail("", "No available observation slots. Maximum %d parallel observations supported.", kMaxParallelObservations);
    return kMaxParallelObservations;
  }
  
  // Initialize observation context
  gObservations[slotIndex].expectedValue = variableValue;
  gObservations[slotIndex].changeResult = 0;
  gObservations[slotIndex].isActive = 1;
  StoreObservationName(slotIndex, sysVarName.name);
  
  // Start the check
  checkID = chkStart_SignalValueChange(sysVarName, "SVC_CAPL_Callback_Sys_Value_Parallel");
  
  if (!checkID)
  {
    gObservations[slotIndex].isActive = 0;
    testStepFail("", "System Variable Value change could not start, System Variable not available OR CAPL callback does not exist");
    return kMaxParallelObservations;
  }
  
  gObservations[slotIndex].checkID = checkID;
  testAddCondition(checkID, VerdictNotExpected);
  testStep("Observation", "Parallel background check [Handle: %d] of System variable : \"%s\" started for value %d", slotIndex, sysVarName.name, variableValue);
  
  return slotIndex;
}

/// <StartParallelObservation/SysInt>
/**
 * @brief Starts parallel background observation for an integer system variable to check if its value is inside or outside a specified range.
*
* @param[in] sysVarName - Int dataType System Variable Name
* @param[in] aMinValue - aMinValue <= aMaxValue
* @param[in] aMaxValue - aMinValue <= aMaxValue
 * @param[in] IsValueInsideRangeExpected YES if value should be inside the range, NO if outside.
*
 * @return dword - Observation handle (slot index) for stopping or validating later
 *
 * @details Initiates monitoring for the system variable to check if its value enters or leaves the specified range in parallel mode.
 *
* @verdict Failed to start background observation \n
*          Passed Successfully started background observation
*///***************************************************************************** 
export dword Lib_SVC_StartParallelObservation(sysvarInt* sysVarName, double aMinValue, double aMaxValue, dword IsValueInsideRangeExpected)
{
  dword slotIndex;
  dword checkID;
  
  #pragma warning(disable: 2038)
  
  slotIndex = FindAvailableObservationSlot();
  
  if (slotIndex >= kMaxParallelObservations)
  {
    testStepFail("", "No available observation slots. Maximum %d parallel observations supported.", kMaxParallelObservations);
    return kMaxParallelObservations;
  }
  
  if (aMinValue > aMaxValue)
  {
    testStepFail("WrongInput", "Lib_SVC_StartParallelObservation()! should be aMinValue (%ld) <= aMaxValue (%ld)", aMinValue, aMaxValue);
    return kMaxParallelObservations;
  }
  
  // Initialize observation context
  gObservations[slotIndex].expectedMinValue = aMinValue;
  gObservations[slotIndex].expectedMaxValue = aMaxValue;
  gObservations[slotIndex].isValueInsideRangeExpected = IsValueInsideRangeExpected;
  gObservations[slotIndex].changeResult = 0;
  gObservations[slotIndex].isActive = 1;
  StoreObservationName(slotIndex, sysVarName.name);
  
  // Start the check
  if (IsValueInsideRangeExpected == 1)
  {
    checkID = ChkStart_MsgSignalValueRangeViolation(sysVarName, aMinValue, aMaxValue, "SVC_CAPL_Callback_Sys_Value_Range_Parallel");
  }
  else
  {
    checkID = ChkStart_MsgSignalValueInvalid(sysVarName, aMinValue, aMaxValue, "SVC_CAPL_Callback_Sys_Value_Range_Parallel");
  }
   
  if (!checkID)
  {
    gObservations[slotIndex].isActive = 0;
    testStepFail("", "System Variable Value change could not start, System Variable not available OR CAPL callback does not exist");
    return kMaxParallelObservations;
  }
  
  gObservations[slotIndex].checkID = checkID;
  testAddCondition(checkID, VerdictNotExpected);
  testStep("Observation", "Parallel background check [Handle: %d] of System variable : \"%s\" started for value range (%ld ... %ld)", slotIndex, sysVarName.name, aMinValue, aMaxValue);
  
  return slotIndex;
}

