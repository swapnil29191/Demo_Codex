/// <StratObservation_CountTime/Signal>
/**
 * @brief Starts background observation for a signal with count and time validation.
 * Monitors if signal value goes inside/outside range and validates that it happens expected number of times within time window.
*
* @param[in] signalName - Signal Name which want to observe
* @param[in] aMinValue - Minimum value of the range (aMinValue <= aMaxValue)
* @param[in] aMaxValue - Maximum value of the range (aMinValue <= aMaxValue)
* @param[in] IsValueInsideRangeExpected - YES if expecting value inside range, NO if expecting outside range
* @param[in] expectedCount - Expected number of changes to occur (e.g., 3 or 4)
* @param[in] timeWindowMs - Time window in milliseconds within which changes must occur (0 = no time limit)
*
 * @return None
 *
 * @details Initiates monitoring for the signal to check:
 *          1. If its value enters or leaves the specified range
 *          2. If the change occurs the expected number of times
 *          3. If all changes occur within the specified time window
 *          
 *          Use Lib_SVC_ValidateResultWithCountAndTime() to validate the result.
 *          After each change, the counter increments. Once expectedCount is reached within
 *          the timeWindow, you can proceed with your test execution.
 *
 * @example
 *          // Monitor if signal goes outside range [100, 200] at least 4 times within 3000ms
 *          Lib_SVC_StartObservation($MySignal, 100, 200, NO, 4, 3000, 1);
 *          // ... wait for changes ...
 *          Lib_SVC_ValidateResultWithCountAndTime(YES, 4, 3000);
 *
* @verdict Failed to start background observation \n
*          Passed Successfully started background observation
*///***************************************************************************** 
export void Lib_SVC_StartObservation(signal* signalName, double aMinValue, double aMaxValue, enum eChangeExpected IsValueInsideRangeExpected
                                                  , dword expectedCount, dword timeWindowMs, enum eChangeExpected expectCriteriaMet)
{
  #pragma warning(disable: 2038)
  
  // Initialize range parameters
  gExpectedMinValue = aMinValue;
  gExpectedMaxValue = aMaxValue;
  gIsValueInsideRangeExpected = IsValueInsideRangeExpected;
  
  // Initialize count and time tracking
  gChangeResult = 0;
  gChangeCount = 0;
  gExpectedCount = expectedCount;
  gTimeWindowMs = timeWindowMs;
  gUserExpectation = expectCriteriaMet;
  gStartTimestamp = timeNowInt64() / 100000; // Convert to milliseconds
  gFirstChangeTimestamp = 0;
  gLastChangeTimestamp = 0;
  
  // Validate input parameters
  if (aMinValue > aMaxValue)
  {
    testStepFail("WrongInput", "Lib_SVC_StartObservation()! should be aMinValue (%ld) <= aMaxValue (%ld)", aMinValue, aMaxValue);
    return;
  }
  
  if (expectedCount == 0)
  {
    testStepFail("WrongInput", "Lib_SVC_StartObservation()! expectedCount must be greater than 0");
    return;
  }
  
  // Start the check with count/time callback
  if (IsValueInsideRangeExpected == 1)
  {
    gCheckID_VC = ChkStart_MsgSignalValueRangeViolation (signalName, aMinValue, aMaxValue, "SVC_CAPL_Callback_Signal_Value_Range_CountTime");
  }
  else
  {
    gCheckID_VC = ChkStart_MsgSignalValueInvalid (signalName, aMinValue, aMaxValue, "SVC_CAPL_Callback_Signal_Value_Range_CountTime");
  }
   
  if (!gCheckID_VC)
  {
    testStepFail("", "Signal Value change could not start, Signal not available OR CAPL callback does not exist");
  }
  
  testAddCondition(gCheckID_VC, VerdictNotExpected);
  testStep("Observation", "Background check of Signal : \"%s\" started for value range (%ld ... %ld), expectedCount: %d, timeWindow: %d ms", 
           signalName.name, aMinValue, aMaxValue, expectedCount, timeWindowMs);
}

//! ==================== CYCLE DETECTION API ====================

/// <StartObservation_CycleDetection/SysInt>
/**
 * @brief Starts cycle detection observation for an integer system variable.
 * Monitors complete violation→recovery cycles (signal goes out of range and returns to normal).
*
* @param[in] sysVarName - Int dataType System Variable Name
* @param[in] aMinValue - Minimum value of the range (aMinValue <= aMaxValue)
* @param[in] aMaxValue - Maximum value of the range (aMinValue <= aMaxValue)
* @param[in] IsValueInsideRangeExpected - YES if expecting value inside range, NO if expecting outside range
* @param[in] expectedCycles - Expected number of complete cycles (violation→recovery)
* @param[in] stopCanoeOnCycleReached - YES to stop CANoe when cycle count is reached
*
 * @return None
 *
 * @details Initiates monitoring for complete cycles:
 *          - A cycle = signal violates range → returns to normal
 *          - Counts only complete cycles (not just violations)
 *          - Optionally stops CANoe when threshold is reached
 *          
 *          Example: Signal voltage drops below 5V briefly, then recovers = 1 cycle
 *
* @example
*          // Detect 3 cycles of voltage dropping below 5V (range 5..100) and stop CANoe
*          Lib_SVC_StartObservation_CycleDetection(@sysvar::Voltage, 5, 100, YES, 3, YES);
*
* @verdict Failed to start background observation \n
*          Passed Successfully started background observation
*///***************************************************************************** 
export void Lib_SVC_StartObservation_CycleDetection(sysvarInt* sysVarName, double aMinValue, double aMaxValue, 
                                                     enum eChangeExpected IsValueInsideRangeExpected,
                                                     dword expectedCycles, 
                                                     enum eChangeExpected stopCanoeOnCycleReached)
{
  #pragma warning(disable: 2038)
  
  // Initialize range parameters
  gExpectedMinValue = aMinValue;
  gExpectedMaxValue = aMaxValue;
  gIsValueInsideRangeExpected = IsValueInsideRangeExpected;
  
  // Initialize cycle tracking
  gChangeResult = 0;
  gCompleteCycleCount = 0;
  gExpectedCycles = expectedCycles;
  gStopCanoeOnCycleReached = stopCanoeOnCycleReached;
  gCurrentState = STATE_NORMAL;
  gViolationStartTime = 0;
  gRecoveryStartTime = 0;
  gLastViolationEndTime = 0;
  gExpectedCycleIntervalMs = 0;
  gCycleIntervalToleranceMs = 0;
  gMinRecoveryDurationMs = 0;
  gUserExpectation = YES; // Default: expect cycles to occur
  gStartTimestamp = timeNowInt64() / 100000;
  
  // Validate input parameters
  if (aMinValue > aMaxValue)
  {
    testStepFail("WrongInput", "Lib_SVC_StartObservation_CycleDetection()! should be aMinValue (%ld) <= aMaxValue (%ld)", aMinValue, aMaxValue);
    return;
  }
  
  if (expectedCycles == 0)
  {
    testStepFail("WrongInput", "Lib_SVC_StartObservation_CycleDetection()! expectedCycles must be greater than 0");
    return;
  }
  
  // Start the check with cycle detection callback
  if (IsValueInsideRangeExpected == YES)
  {
    gCheckID_VC = ChkStart_MsgSignalValueRangeViolation (sysVarName, aMinValue, aMaxValue, "SVC_CAPL_Callback_Sys_Value_Range_CycleDetection");
  }
  else
  {
    gCheckID_VC = ChkStart_MsgSignalValueInvalid (sysVarName, aMinValue, aMaxValue, "SVC_CAPL_Callback_Sys_Value_Range_CycleDetection");
  }
   
  if (!gCheckID_VC)
  {
    testStepFail("", "System Variable cycle detection could not start, Variable not available OR CAPL callback does not exist");
    return;
  }
  
  testAddCondition(gCheckID_VC, VerdictNotExpected);
  testStep("Observation", "Cycle detection started for System variable : \"%s\" (Range: %ld...%ld, Expected cycles: %d, Stop CANoe: %d)", 
           sysVarName.name, aMinValue, aMaxValue, expectedCycles, stopCanoeOnCycleReached);
}

/// <StartObservation_CycleDetection/SysInt>
/**
 * @brief Starts cycle detection observation with interval validation for an integer system variable.
*
* @param[in] sysVarName - Int dataType System Variable Name
* @param[in] aMinValue - Minimum value of the range
* @param[in] aMaxValue - Maximum value of the range
* @param[in] IsValueInsideRangeExpected - YES if expecting value inside range, NO if expecting outside
* @param[in] expectedCycles - Expected number of complete cycles
* @param[in] stopCanoeOnCycleReached - YES to stop CANoe when cycle count is reached
* @param[in] expectedCycleIntervalMs - Expected time between cycles in ms (0 = no validation)
* @param[in] cycleIntervalToleranceMs - Tolerance for cycle interval validation in ms
*
 * @return None
 *
 * @details Enhanced cycle detection with periodic validation:
 *          - Monitors complete violation→recovery cycles
 *          - Validates that cycles occur at regular intervals (e.g., every ~10 seconds)
 *          - Warns if cycle interval is outside tolerance
 *
* @example
*          // Detect 4 cycles occurring every 10s ± 2s, stop CANoe when reached
*          Lib_SVC_StartObservation_CycleDetection(@sysvar::Voltage, 5, 100, YES, 4, YES, 10000, 2000);
*
*///***************************************************************************** 
export void Lib_SVC_StartObservation_CycleDetection(sysvarInt* sysVarName, double aMinValue, double aMaxValue, 
                                                     enum eChangeExpected IsValueInsideRangeExpected,
                                                     dword expectedCycles, 
                                                     enum eChangeExpected stopCanoeOnCycleReached,
                                                     dword expectedCycleIntervalMs,
                                                     dword cycleIntervalToleranceMs)
{
  #pragma warning(disable: 2038)
  
  // Initialize range parameters
  gExpectedMinValue = aMinValue;
  gExpectedMaxValue = aMaxValue;
  gIsValueInsideRangeExpected = IsValueInsideRangeExpected;
  
  // Initialize cycle tracking with interval validation
  gChangeResult = 0;
  gCompleteCycleCount = 0;
  gExpectedCycles = expectedCycles;
  gStopCanoeOnCycleReached = stopCanoeOnCycleReached;
  gCurrentState = STATE_NORMAL;
  gViolationStartTime = 0;
  gRecoveryStartTime = 0;
  gLastViolationEndTime = 0;
  gExpectedCycleIntervalMs = expectedCycleIntervalMs;
  gCycleIntervalToleranceMs = cycleIntervalToleranceMs;
  gMinRecoveryDurationMs = 0;
  gUserExpectation = YES;
  gStartTimestamp = timeNowInt64() / 100000;
  
  // Validate input parameters
  if (aMinValue > aMaxValue)
  {
    testStepFail("WrongInput", "Lib_SVC_StartObservation_CycleDetection()! should be aMinValue (%ld) <= aMaxValue (%ld)", aMinValue, aMaxValue);
    return;
  }
  
  if (expectedCycles == 0)
  {
    testStepFail("WrongInput", "Lib_SVC_StartObservation_CycleDetection()! expectedCycles must be greater than 0");
    return;
  }
  
  // Start the check with cycle detection callback
  if (IsValueInsideRangeExpected == YES)
  {
    gCheckID_VC = ChkStart_MsgSignalValueRangeViolation (sysVarName, aMinValue, aMaxValue, "SVC_CAPL_Callback_Sys_Value_Range_CycleDetection");
  }
  else
  {
    gCheckID_VC = ChkStart_MsgSignalValueInvalid (sysVarName, aMinValue, aMaxValue, "SVC_CAPL_Callback_Sys_Value_Range_CycleDetection");
  }
   
  if (!gCheckID_VC)
  {
    testStepFail("", "System Variable cycle detection could not start, Variable not available OR CAPL callback does not exist");
    return;
  }
  
  testAddCondition(gCheckID_VC, VerdictNotExpected);
  testStep("Observation", "Cycle detection started for System variable : \"%s\" (Range: %ld...%ld, Expected cycles: %d, Interval: %d ms ± %d ms)", 
           sysVarName.name, aMinValue, aMaxValue, expectedCycles, expectedCycleIntervalMs, cycleIntervalToleranceMs);
}

