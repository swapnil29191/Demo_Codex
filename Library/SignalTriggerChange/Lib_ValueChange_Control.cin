  // Start the check with count/time callback
  if (IsValueInsideRangeExpected == 1)
  {
    gCheckID_VC = ChkStart_MsgSignalValueRangeViolation (sysVarName, aMinValue, aMaxValue, "SVC_CAPL_Callback_Sys_Value_Range_CountTime");
