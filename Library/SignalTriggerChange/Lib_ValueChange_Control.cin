/// <StartObervation/Signal>
/**
 * @brief Starts background observation for value changes of a signal.
*
* @param[in] signalName - Signal Name which want to observe
*
 * @details Initiates monitoring for any value change of the specified signal.
 *          If the observation cannot be started (e.g., signal not mapped or callback missing),
 *          a test step failure is reported.
 *
* @verdict Failed to start background observation \n
*          Passed Successfully started background observation
*///*****************************************************************************
export void Lib_SVC_StartObservation(signal* signalName)
{
  #pragma warning(disable: 2038)
  gChangeResult = 0;
  
  // checks that there is no change of the value of the signal
  gCheckID_VC = chkStart_SignalValueChange (signalName, "SVC_CAPL_Callback_Signal");
  
  if (!gCheckID_VC)
  {
    testStepFail("", "Signal Value change could not start, Signal is not mapped to message OR CAPL callback does not exist");
  }
  
  testAddCondition(gCheckID_VC, VerdictNotExpected);
  testStep("Observation", "Background check of Signal : \" %s \" started", signalName.name);
}

