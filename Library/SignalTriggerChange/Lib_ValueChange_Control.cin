  // Initialize count and time tracking
  gChangeResult = 0;
  gChangeCount = 0;
  gExpectedCount = expectedCount;
  gTimeWindowMs = timeWindowMs;
  gUserExpectation = expectCriteriaMet;
  gStartTimestamp = timeNowInt64() / 100000; // Convert to milliseconds
  gFirstChangeTimestamp = 0;
  gLastChangeTimestamp = 0;
  
