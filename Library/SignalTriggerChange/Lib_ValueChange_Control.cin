/// <StartParallelObservation/Signal>
/**
 * @brief Starts parallel background observation for a signal to check if its value is inside or outside a specified range.
*
* @param[in] signalName - Signal Name which want to observe
* @param[in] aMinValue - aMinValue <= aMaxValue
* @param[in] aMaxValue - aMinValue <= aMaxValue
* @param[in] IsValueInsideRangeExpected - YES or NO. If expected then YES
*
 * @return dword - Observation handle (slot index) for stopping or validating later
 *
 * @details Initiates monitoring for the signal to check if its value enters or leaves the specified range in parallel mode.
 *
* @verdict Failed to start background observation \n
*          Passed Successfully started background observation
*///***************************************************************************** 
export dword Lib_SVC_StartParallelObservation(signal* signalName, double aMinValue, double aMaxValue, dword IsValueInsideRangeExpected)
{
  dword slotIndex;
  dword checkID;
  
  #pragma warning(disable: 2038)
  
  slotIndex = FindAvailableObservationSlot();
  
  if (slotIndex >= kMaxParallelObservations)
  {
    testStepFail("", "No available observation slots. Maximum %d parallel observations supported.", kMaxParallelObservations);
    return kMaxParallelObservations;
  }
  
  if (aMinValue > aMaxValue)
  {
    testStepFail("WrongInput", "Lib_SVC_StartParallelObservation()! should be aMinValue (%ld) <= aMaxValue (%ld)", aMinValue, aMaxValue);
    return kMaxParallelObservations;
  }
  
  // Initialize observation context
  gObservations[slotIndex].expectedMinValue = aMinValue;
  gObservations[slotIndex].expectedMaxValue = aMaxValue;
  gObservations[slotIndex].isValueInsideRangeExpected = IsValueInsideRangeExpected;
  gObservations[slotIndex].changeResult = 0;
  gObservations[slotIndex].isActive = 1;
  StoreObservationName(slotIndex, signalName.name);
  
  // Start the check
  if (IsValueInsideRangeExpected == 1)
  {
    checkID = ChkStart_MsgSignalValueRangeViolation(signalName, aMinValue, aMaxValue, "SVC_CAPL_Callback_Signal_Value_Range_Parallel");
  }
  else
  {
    checkID = ChkStart_MsgSignalValueInvalid(signalName, aMinValue, aMaxValue, "SVC_CAPL_Callback_Signal_Value_Range_Parallel");
  }
   
  if (!checkID)
  {
    gObservations[slotIndex].isActive = 0;
    testStepFail("", "Signal Value change could not start, Signal not available OR CAPL callback does not exist");
    return kMaxParallelObservations;
  }
  
  gObservations[slotIndex].checkID = checkID;
  testAddCondition(checkID, VerdictNotExpected);
  testStep("Observation", "Parallel background check [Handle: %d] of Signal : \"%s\" started for value range (%ld ... %ld)", slotIndex, signalName.name, aMinValue, aMaxValue);
  
  return slotIndex;
}

/// <StartParallelObservation>
/**
* @brief Stops a specific parallel background observation identified by its handle.
*
* @param[in] observationHandle - The handle returned by Lib_SVC_StartParallelObservation
*
* @details Removes the test condition associated with the specified observation and logs the stop event.
*          Does not affect other ongoing observations.
*
* @verdict Failed to stop observation \n
*          Passed Successfully stopped background observation
*///*****************************************************************************
export void Lib_SVC_StopParallelObservation(dword observationHandle)
{
  long ret;
  
  if (observationHandle >= kMaxParallelObservations)
  {
    testStepFail("Observation", "Invalid observation handle: %d", observationHandle);
    return;
  }
  
  if (!gObservations[observationHandle].isActive)
  {
    testStepFail("Observation", "Observation handle %d is not active", observationHandle);
    return;
  }
  
  ret = testRemoveCondition(gObservations[observationHandle].checkID);
  
  if (ret == 0)
    testStep("Observation", "Parallel background check [Handle: %d] for \"%s\" stopped.", observationHandle, gObservations[observationHandle].observedName);
  else
    testStepFail("Observation", "Parallel background check [Handle: %d] could not be stopped. Constraint could not be removed", observationHandle);
  
  // Stop the check
  ChkControl_Stop(gObservations[observationHandle].checkID);

  // Reset stored values of the check
  ChkControl_Destroy(gObservations[observationHandle].checkID);
  
  // Mark slot as inactive
  gObservations[observationHandle].isActive = 0;
  gObservations[observationHandle].checkID = 0;
  gObservations[observationHandle].changeResult = 0;
}

/// <StartParallelObservation>
/**
* @brief Validates whether a value change occurred for a specific parallel observation.
*
* @param[in] observationHandle - The handle returned by Lib_SVC_StartParallelObservation
* @param[in] IsChangeExpected - YES if a change was expected, NO otherwise.
*
* @details Checks if the observed value change matches the expectation for the specified observation 
*          and reports the result as a test step pass or fail.
*
*///*****************************************************************************
export void Lib_SVC_ValidateParallelResult(dword observationHandle, enum eChangeExpected IsChangeExpected)
{
  if (observationHandle >= kMaxParallelObservations)
  {
    testStepFail("Validation", "Invalid observation handle: %d", observationHandle);
    return;
  }
  
  if (!gObservations[observationHandle].isActive)
  {
    testStepFail("Validation", "Observation handle %d is not active", observationHandle);
    return;
  }
  
  if (IsChangeExpected == 1)
  {
    if(gObservations[observationHandle].changeResult)
      testStepPass("Validation", "[Handle: %d] Signal Or SysVariable \"%s\" value has changed as Expected", observationHandle, gObservations[observationHandle].observedName);
    else
      testStepFail("Validation", "[Handle: %d] Signal Or SysVariable \"%s\" value has NOT changed as Expected", observationHandle, gObservations[observationHandle].observedName); 
  }
  else
  {
    if(gObservations[observationHandle].changeResult == 0)
      testStepPass("Validation", "[Handle: %d] Signal Or SysVariable \"%s\" value has NOT changed as Expected", observationHandle, gObservations[observationHandle].observedName);
    else
      testStepFail("Validation", "[Handle: %d] Signal Or SysVariable \"%s\" value has changed which is not Expected", observationHandle, gObservations[observationHandle].observedName);
  }
}

/// <StartParallelObservation>
/**
* @brief Stops all active parallel observations.
*
* @details Iterates through all observation slots and stops any active observations.
*          Useful for cleanup or resetting the observation state.
*
*///*****************************************************************************
export void Lib_SVC_StopAllParallelObservations()
{
  dword i;
  dword stoppedCount = 0;
  
  for (i = 0; i < kMaxParallelObservations; i++)
  {
    if (gObservations[i].isActive)
    {
      testRemoveCondition(gObservations[i].checkID);
      ChkControl_Stop(gObservations[i].checkID);
      ChkControl_Destroy(gObservations[i].checkID);
      gObservations[i].isActive = 0;
      gObservations[i].checkID = 0;
      gObservations[i].changeResult = 0;
      stoppedCount++;
    }
  }
  
  testStep("Observation", "Stopped %d parallel observation(s)", stoppedCount);
}






