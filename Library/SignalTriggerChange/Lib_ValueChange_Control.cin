/// <StartObervation/SysInt>
/**
 * @brief Starts background observation for value changes of an integer system variable.
*
* @param[in] sysVarName - Int dataType System Variable Name
*
 * @return None
 * @details Initiates monitoring for any value change of the specified integer system variable.
 *          If the observation cannot be started (e.g., variable not available or callback missing),
 *          a test step failure is reported.
 *
* @verdict Failed to start background observation \n
*          Passed Successfully started background observation
*///***************************************************************************** 
export void Lib_SVC_StartObservation(sysvarInt* sysVarName)
{
  #pragma warning(disable: 2038)
  gChangeResult = 0;
  
  // checks that there is no change of the value of the signal
  gCheckID_VC = chkStart_SignalValueChange (sysVarName, "SVC_CAPL_Callback_Sys");
  
  if (!gCheckID_VC)
  {
    testStepFail("", "System Variable Value change could not start, System Variable not available OR CAPL callback does not exist");
  }
  
  testAddCondition(gCheckID_VC, VerdictNotExpected); 
  testStep("Observation", "Background check of System variable : \" %s \" started", sysVarName.name);
}

/// <StartObervation/SysInt>
/**
 * @brief Starts background observation for a specific value change of an integer system variable.
*
* @param[in] sysVarName - Int dataType System Variable Name
* @param[in] variableValue - Expected variable value change
*
 * @return None
 *
 * @details Initiates monitoring for a specific value change of the given integer system variable.
 *          If the observation cannot be started, a test step failure is reported.
 *
* @verdict Failed to start background observation \n
*          Passed Successfully started background observation
*///***************************************************************************** 
export void Lib_SVC_StartObservation(sysvarInt* sysVarName, long variableValue)
{
  #pragma warning(disable: 2038)
  gExpectedValue = variableValue;
  gChangeResult = 0;
  
  // checks that there is no change of the value of the signal
  gCheckID_VC = chkStart_SignalValueChange (sysVarName, "SVC_CAPL_Callback_Sys_Value");
  
  if (!gCheckID_VC)
  {
    testStepFail("", "System Variable Value change could not start, System Variable not available OR CAPL callback does not exist");
  }
  
  testAddCondition(gCheckID_VC, VerdictNotExpected);
  testStep("Observation", "Background check of System variable : \" %s \" started for value %d", sysVarName.name, variableValue);
}

/// <StartObervation/SysInt>
/**
 * @brief Starts background observation for an integer system variable to check if its value is inside or outside a specified range.
* An event will be generated, if the value of system variable is inside/outside the given value range.
*
* @param[in] sysVarName - Int dataType System Variable Name
* @param[in] aMinValue - aMinValue <= aMaxValue
* @param[in] aMaxValue - aMinValue <= aMaxValue
 * @param[in] IsValueInsideRangeExpected YES if value should be inside the range, NO if outside.
*
 * @return None
 *
 * @details Initiates monitoring for the system variable to check if its value enters or leaves the specified range.
 *          If the minimum value is greater than the maximum, a test step failure is reported.
 *          If the observation cannot be started, a test step failure is reported.
 *
* @verdict Failed to start background observation \n
*          Passed Successfully started background observation
*///***************************************************************************** 
export void Lib_SVC_StartObservation(sysvarInt* sysVarName, double aMinValue, double aMaxValue, enum eChangeExpected IsValueInsideRangeExpected)
{
  #pragma warning(disable: 2038)
  gExpectedMinValue = aMinValue;
  gExpectedMaxValue = aMaxValue;
  gIsValueInsideRangeExpected = IsValueInsideRangeExpected;
  gChangeResult = 0;
  
  if (aMinValue > aMaxValue)
  {
    testStepFail("WrongInput", "Lib_SVC_StartObservation()! should be aMinValue (%ld) <= aMaxValue (%ld)", aMinValue, aMaxValue);
    return;
  }
  
  // checks that there is no change of the value of the signal
  if (IsValueInsideRangeExpected == 1)
  {
    gCheckID_VC = ChkStart_MsgSignalValueRangeViolation (sysVarName, aMinValue, aMaxValue, "SVC_CAPL_Callback_Sys_Value_Range");
  }
  else
  {
    gCheckID_VC = ChkStart_MsgSignalValueInvalid (sysVarName, aMinValue, aMaxValue, "SVC_CAPL_Callback_Sys_Value_Range");
  }
   
  if (!gCheckID_VC)
  {
    testStepFail("", "System Variable Value change could not start, System Variable not available OR CAPL callback does not exist");
  }
  
  testAddCondition(gCheckID_VC, VerdictNotExpected);
  testStep("Observation", "Background check of System variable : \" %s \" started for value range (%ld ... %ld)", sysVarName.name, aMinValue, aMaxValue);
}

/// <StratObservation_CountTime/SysInt>
/**
 * @brief Starts background observation for an integer system variable with count and time validation.
 * Monitors if value goes inside/outside range and validates that it happens expected number of times within time window.
*
* @param[in] sysVarName - Int dataType System Variable Name
* @param[in] aMinValue - Minimum value of the range (aMinValue <= aMaxValue)
* @param[in] aMaxValue - Maximum value of the range (aMinValue <= aMaxValue)
* @param[in] IsValueInsideRangeExpected - YES if expecting value inside range, NO if expecting outside range
* @param[in] expectedCount - Expected number of changes to occur (e.g., 3 or 4)
* @param[in] timeWindowMs - Time window in milliseconds within which changes must occur (0 = no time limit)
* @param[in] expectCriteriaMet - 1 if meeting count+time criteria should result in PASS, 0 if meeting should result in FAIL
*
 * @return None
 *
 * @details Initiates monitoring for the system variable to check:
 *          1. If its value enters or leaves the specified range
 *          2. If the change occurs the expected number of times
 *          3. If all changes occur within the specified time window
 *          
 *          Use Lib_SVC_ValidateResultWithCountAndTime() to validate the result.
 *          Each change increments a counter. After reaching expectedCount, validation can be performed.
 *
 * @example
 *          // Monitor if value goes outside range [10, 50] at least 3 times within 5000ms, expecting it to meet criteria
 *          Lib_SVC_StartObservation(@sysvar::MyVar, 10, 50, NO, 3, 5000, 1);
 *          // ... wait for changes ...
 *          Lib_SVC_ValidateResultWithCountAndTime(YES, 3, 5000);
 *
* @verdict Failed to start background observation \n
*          Passed Successfully started background observation
*///***************************************************************************** 
export void Lib_SVC_StartObservation(sysvarInt* sysVarName, double aMinValue, double aMaxValue, enum eChangeExpected IsValueInsideRangeExpected
                                                , dword expectedCount, dword timeWindowMs, enum eChangeExpected expectCriteriaMet)
{
  #pragma warning(disable: 2038)
  
  // Initialize range parameters
  gExpectedMinValue = aMinValue;
  gExpectedMaxValue = aMaxValue;
  gIsValueInsideRangeExpected = IsValueInsideRangeExpected;
  
  // Initialize count and time tracking
  gChangeResult = 0;
  gChangeCount = 0;
  gExpectedCount = expectedCount;
  gTimeWindowMs = timeWindowMs;
  gUserExpectation = expectCriteriaMet;
  gStartTimestamp = timeNowInt64() / 100000; // Convert to milliseconds
  gFirstChangeTimestamp = 0;
  gLastChangeTimestamp = 0;
  
  // Validate input parameters
  if (aMinValue > aMaxValue)
  {
    testStepFail("WrongInput", "Lib_SVC_StartObservation()! should be aMinValue (%ld) <= aMaxValue (%ld)", aMinValue, aMaxValue);
    return;
  }
  
  if (expectedCount == 0)
  {
    testStepFail("WrongInput", "Lib_SVC_StartObservation()! expectedCount must be greater than 0");
    return;
  }
  
  // Start the check with count/time callback
  if (IsValueInsideRangeExpected == 1)
  {
    gCheckID_VC = ChkStart_MsgSignalValueRangeViolation (sysVarName, aMinValue, aMaxValue, "SVC_CAPL_Callback_Sys_Value_Range_CountTime");
  }
  else
  {
    gCheckID_VC = ChkStart_MsgSignalValueInvalid (sysVarName, aMinValue, aMaxValue, "SVC_CAPL_Callback_Sys_Value_Range_CountTime");
  }
   
  if (!gCheckID_VC)
  {
    testStepFail("", "System Variable Value change could not start, System Variable not available OR CAPL callback does not exist");
  }
  
  testAddCondition(gCheckID_VC, VerdictNotExpected);
  testStep("Observation", "Background check of System variable : \"%s\" started for value range (%ld ... %ld), expectedCount: %d, timeWindow: %d ms", 
           sysVarName.name, aMinValue, aMaxValue, expectedCount, timeWindowMs);
}

