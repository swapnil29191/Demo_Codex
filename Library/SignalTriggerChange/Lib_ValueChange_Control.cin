  testAddCondition(gCheckID_VC, VerdictNotExpected);
  testStep("Observation", "Background check of System variable : \"%s\" started for value range (%ld ... %ld), expectedCount: %d, timeWindow: %d ms", 
           sysVarName.name, aMinValue, aMaxValue, expectedCount, timeWindowMs);
